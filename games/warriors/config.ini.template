# PS2Recomp configuration for: SLUS_214.72 — The Warriors (USA)
# Copy this file to config.ini and set the paths below before running ps2xRecomp.
# Generated by the install wizard or manually by the developer.

[general]
# Path to the extracted ELF from the ISO (set by install wizard)
input = "@ELF@"

# Path to Ghidra-exported function map CSV (optional but recommended for stubs)
ghidra_output = "@CSV@"

# Output directory for generated C++ sources
output = "@OUT@"

# Single-file output — disable for large games like this one (faster incremental builds)
single_file_output = false

# Patch policy
patch_syscalls = false
patch_cop0 = true
patch_cache = true

