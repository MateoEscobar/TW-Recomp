# Build output
build/
deploy/
dist/

# Recompiler generated sources (massive, regenerated each build)
games/warriors/work/
games/warriors/recomp_out/

# Game assets extracted from ISO — NEVER commit game data
games/warriors/assets/
games/warriors/SLUS_*
games/warriors/*.iso
games/warriors/*.img
# [TWR-29] IRX modules extracted from the disc for the emulated IOP (fallback when
# PS2X_CD_IMAGE is not set). Game data: never committed.
games/warriors/IRX/
games/warriors/vu1_micro/
games/warriors/Modules/
# [TWR-27] disc tree extracted by scripts/extract_iso.py --all (install layout; BYOD)
games/warriors/SYSTEM.CNF
games/warriors/WARRIORS.DIR
games/warriors/WARRIORS.WAD
games/warriors/IOP/
games/warriors/MODULES/
games/warriors/PSS/
*.iso
*.img
*.7z

# Save files
*.sav
*.mcr

# IDE / OS
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db

