+uint32_t PS2Runtime::cop0Count() const
+{
+    return static_cast<uint32_t>(eeScheduler().eeCycle()) + m_cop0CountBias;
+}
+
+void PS2Runtime::setCop0Count(uint32_t value)
+{
+    m_cop0CountBias = value - static_cast<uint32_t>(eeScheduler().eeCycle());
+    m_cpuContext.cop0_count = value;
+}
