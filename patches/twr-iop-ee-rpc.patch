+            if (traceIopToEe())
+                std::cerr << "[iop-ee-rpc] sid=0x" << std::hex << call.sid << " fno=" << std::dec << call.function
+                          << " size=" << sendSize << " rsize=" << call.receiveSize << " func=0x" << std::hex
+                          << server->func << std::dec << std::endl;
+
+            // The server function runs on the server thread, below its current frame, as in sceSifExecRequest.
+            const R5900Context *current = scheduler.currentContext();
+            GuestInvocation invocation;
+            invocation.kind = GuestInvocationKind::RpcCallback;
+            invocation.tag = queue;
+            invocation.context = *current;
+            invocation.context.pc = server->func;
+            SET_GPR_U32(&invocation.context, 4, call.function);
+            SET_GPR_U32(&invocation.context, 5, server->buf);
+            SET_GPR_U32(&invocation.context, 6, sendSize);
+            SET_GPR_U32(&invocation.context, 31, 0u);
+            SET_GPR_U32(&invocation.context, 29, (getRegU32(current, 29) - 0x40u) & ~0xFu);
+            const uint64_t callId = call.callId;
+            const uint32_t receiveSize = call.receiveSize;
+            invocation.onComplete = [runtime, queue, callId, receiveSize](const R5900Context &done, R5900Context &)
+            {
+                // The server returns the address of its reply (sceSifExecRequest copies rsize bytes from it).
+                std::vector<uint8_t> reply(receiveSize, 0u);
+                const uint32_t replyPtr = getRegU32(&done, 2);
+                if (receiveSize != 0u && replyPtr != 0u)
+                {
+                    if (const uint8_t *source = getMemPtr(runtime->memory().getRDRAM(), replyPtr))
+                        std::memcpy(reply.data(), source, receiveSize);
+                }
+                runtime->completeIopGuestRpc(callId, reply.data(), receiveSize);
+                // Back to the loop instead of returning from sceSifRpcLoop.
+                if (GuestThread *thread = runtime->eeScheduler().currentThread())
+                    thread->resumeCompletion = rpcLoopResume(runtime, queue);
+            };
+            scheduler.invokeCurrent(std::move(invocation));
+        }
+    }
+
+    bool hasEeRpcServer(uint32_t sid)
+    {
+        std::lock_guard<std::mutex> lock(g_rpc_mutex);
+        return g_rpc_servers.find(sid) != g_rpc_servers.end();
+    }
+
+    bool postIopRpcToEe(PS2Runtime *runtime, uint32_t sid, uint32_t function, const void *send, uint32_t sendSize,
+                        uint32_t receiveSize, uint64_t callId)
+    {
+        if (!runtime)
+            return false;
+        uint32_t serverPtr = 0u;
+        {
+            std::lock_guard<std::mutex> lock(g_rpc_mutex);
+            const auto server = g_rpc_servers.find(sid);
+            if (server == g_rpc_servers.end())
+                return false;
+            serverPtr = server->second.sd_ptr;
+        }
+        const auto *server = reinterpret_cast<const t_SifRpcServerData *>(getMemPtr(runtime->memory().getRDRAM(), serverPtr));
+        if (!server || server->base == 0u)
+        {
+            std::cerr << "[iop-ee-rpc] sid=0x" << std::hex << sid << " registrado sin cola (sceSifSetRpcQueue)" << std::dec
+                      << std::endl;
+            return false;
+        }
+        IopToEeCall call;
+        call.sid = sid;
+        call.function = function;
+        call.send.assign(static_cast<const uint8_t *>(send), static_cast<const uint8_t *>(send) + sendSize);
+        call.receiveSize = receiveSize;
+        call.callId = callId;
+        g_iop_to_ee_calls[server->base].push_back(std::move(call));
+        // Woken at the next scheduler checkpoint (the IOP runs inside one; no reentry into the scheduler here).
+        runtime->postEeEvent(EeEvent{EeEventType::ExternalWake, kRpcQueueWaitType, server->base});
+        return true;
+    }
+
+    void SifRpcLoop(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        rpcLoopStep(runtime, getRegU32(ctx, 4));
+    }
 }
