+    // TWR: overrides found through the export table (library + ordinal), so they also fit another build of the IRX.
+    // A LIBSD whose sceSdGetParam is not where the built-in table expects must still get the native override, and the
+    // override that has no ordinal ("libsd bus setup") must be reported as not applied. The same code under another
+    // module name is the control: nothing replaces it and the guest function runs.
+    {
+        const std::vector<uint8_t> image = makeOrdinalOverrideIrx();
+        {
+            TestHost libsdHost(0x20000u);
+            libsdHost.hostFiles["cdrom0:\\MODULES\\LIBSD.IRX;1"] = image;
+            IopSubsystem libsdIop(libsdHost);
+            const ModuleLoadResult libsd = libsdIop.loadModule("cdrom0:\\MODULES\\LIBSD.IRX;1");
+            if (!expect(libsd.handled && libsd.moduleId > 0, "The synthetic LIBSD.IRX did not load")) return 1;
+            if (!expect(libsd.startResult != 0x4242,
+                        "The native override was not applied through the export table (the guest function ran)")) return 1;
+            const auto mentions = [&](const char *text)
+            {
+                return std::any_of(libsdHost.logs.begin(), libsdHost.logs.end(),
+                                   [&](const std::string &message)
+                                   { return message.find("native overrides not applied") != std::string::npos &&
+                                            message.find(text) != std::string::npos; });
+            };
+            if (!expect(mentions("libsd bus setup"),
+                        "The override without an ordinal was not reported as not applied for another build")) return 1;
+            if (!expect(!mentions("sceSdGetParam"),
+                        "The override found through its ordinal was reported as not applied")) return 1;
+        }
+        {
+            TestHost otherHost(0x20000u);
+            otherHost.hostFiles["cdrom0:\\MODULES\\OTHER.IRX;1"] = image;
+            IopSubsystem otherIop(otherHost);
+            const ModuleLoadResult other = otherIop.loadModule("cdrom0:\\MODULES\\OTHER.IRX;1");
+            if (!expect(other.handled && other.moduleId > 0, "The control IRX did not load")) return 1;
+            if (!expect(other.startResult == 0x4242,
+                        "Control: a module without overrides must run its own guest function")) return 1;
+        }
+    }
+
+    // TWR: an RPC server registered by a thread that entered sceSifRpcLoop runs in THAT thread. The first
+    // attempt ran it in a new service thread and the wake-up of the loop thread was lost (black screen on the Warriors).
+    {
+        TestHost loopHost(0x20000u);
+        IopSubsystem loopIop(loopHost);
+        constexpr uint32_t loopSid = 0x5EC0DE01u;
+        const std::vector<uint8_t> loopImage = makeRpcLoopThreadIrx(loopSid);
+        std::memcpy(loopHost.guest.data() + 0x100u, loopImage.data(), loopImage.size());
+        const ModuleLoadResult loopModule = loopIop.loadModuleBuffer(0x100u);
+        if (!expect(loopModule.handled && loopModule.startResult == 0, "The RPC loop thread IRX did not start")) return 1;
+        for (int i = 0; i < 200 && !loopIop.canBindRpc(loopSid); ++i)
+            loopIop.runEeCycles(100000u);
+        if (!expect(loopIop.canBindRpc(loopSid), "The thread never registered its RPC server")) return 1;
+        uint32_t loopThreadId = 0u, loopFrameSp = 0u;
+        if (!expect(loopIop.readMemory(0x00010700u, &loopThreadId, sizeof(loopThreadId)) && loopThreadId != 0u &&
+                        loopIop.readMemory(0x00010704u, &loopFrameSp, sizeof(loopFrameSp)) && loopFrameSp != 0u,
+                    "The loop thread did not record its id and stack pointer")) return 1;
+        if (!expect(loopIop.debugSnapshot().emulatorRpcServers == 1u, "Registered RPC server count mismatch")) return 1;
+        // The server function starts below the loop frame (sp = (loopSp - 0x40) & ~15), then its own prologue
+        // takes 0x18 more. Another thread would run it on its own stack.
+        const uint32_t expectedServerSp = ((loopFrameSp - 0x40u) & ~15u) - 0x18u;
+        for (uint32_t call = 0u; call < 2u; ++call)
+        {
+            const size_t completedBefore = loopHost.completedIopRpcs.size();
+            const uint32_t receiveAddress = 0x900u + 0x10u * call;
+            std::memset(loopHost.guest.data() + receiveAddress, 0, sizeof(uint32_t));
+            RpcRequest request{};
+            request.sid = loopSid;
+            request.receive = {receiveAddress, sizeof(uint32_t)};
+            const RpcResult result = loopIop.handleRpc(request);
+            if (!expect(result.handled, "The EE call to the loop-thread server was not handled")) return 1;
+            for (int i = 0; i < 200 && result.pending && loopHost.completedIopRpcs.size() == completedBefore; ++i)
+                loopIop.runEeCycles(100000u);
+            uint32_t serverSp = 0u;
+            std::memcpy(&serverSp, loopHost.guest.data() + receiveAddress, sizeof(serverSp));
+            if (!expect(serverSp == expectedServerSp,
+                        "The server function did not run in the sceSifRpcLoop thread, below its loop frame")) return 1;
+        }
+    }
