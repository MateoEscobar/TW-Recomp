+        {
+            // TWR: RenderWare queues a frame of texture uploads with PATH3 masked and opens one MSKPATH3 0/1 window
+            // per mesh; on hardware each window lets one packet (up to EOP) through and FLUSHA waits for PATH3.
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            size_t emittedBytes = 0u;
+            mem.setGifPacketCallback([&](const uint8_t *, uint32_t sizeBytes) { emittedBytes += sizeBytes; });
+
+            // IMAGE GIFtag with NLOOP qwords of payload.
+            const auto appendImage = [](std::vector<uint8_t> &out, uint32_t loops, bool eop, uint8_t fill)
+            {
+                const uint64_t lo = static_cast<uint64_t>(loops) | (eop ? (1ull << 15u) : 0u) | (2ull << 58u);
+                std::array<uint8_t, 16u> tag{};
+                std::memcpy(tag.data(), &lo, sizeof(lo));
+                out.insert(out.end(), tag.begin(), tag.end());
+                out.insert(out.end(), static_cast<size_t>(loops) * 16u, fill);
+            };
+            const auto mask = [&](bool on)
+            {
+                const uint32_t cmd = makeVifCmd(0x06u, 0u, on ? 0x8000u : 0x0000u);
+                mem.processVIF1Data(reinterpret_cast<const uint8_t *>(&cmd), sizeof(cmd));
+            };
+            const auto fqc = [&] { return (mem.readIORegister(0x10003020u) >> 24) & 0x1Fu; };
+
+            // An unmask with nothing queued opens no packet: the next masked upload is queued (Warriors spins at
+            // 0x48B9A8 until GIF_STAT.FQC sees it).
+            mask(true);
