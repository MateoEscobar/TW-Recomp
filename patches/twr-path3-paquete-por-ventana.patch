+bool PS2Memory::path3EopMaskEnabled()
+{
+    // PS2X_P3_EOPMASK=0: the old behaviour (an unmask releases the whole queue), for A/B comparisons.
+    static const bool enabled = []
+    {
+        const char *value = std::getenv("PS2X_P3_EOPMASK");
+        return !(value && value[0] == '0');
+    }();
+    return enabled;
+}
+
+// TWR: on hardware (PCSX2 Vif_Codes.cpp / Gif_Unit.h) MSKPATH3 takes effect at the end of the PATH3 packet in flight,
+// so each MSKPATH3 0 / MSKPATH3 1 window lets exactly one GIF packet (up to EOP) through, and FLUSHA waits for PATH3.
+// RenderWare (The Warriors) queues a frame of texture uploads on DMA channel 2 (~232 uploads, ~69000 qw) with PATH3
+// masked and, per mesh, issues FLUSHA / MSKPATH3 0 / MSKPATH3 1, reusing the same VRAM slots: releasing the whole
+// queue at the first unmask drew every mesh with the last texture put in its slot (noise / foreign palettes).
+// Slices are emitted in place (no concatenation): the GIF arbiter follows GIFtags across submissions.
+void PS2Memory::releaseOneMaskedPath3Packet()
+{
+    syncGsWorkerIfOtherThread("releaseOneMaskedPath3Packet");
+    if (m_path3MaskedFifo.empty())
+        return; // nothing queued: no packet is in flight, the next masked submission must be queued
+    bool ended = false;
+    while (!m_path3MaskedFifo.empty() && !ended)
+    {
+        const std::vector<uint8_t> &packet = m_path3MaskedFifo.front();
+        const size_t head = std::min(m_path3MaskedHead, packet.size());
+        const size_t length = path3PacketSpan(packet.data() + head, packet.size() - head, ended);
+        if (length != 0u)
+        {
+            if (m_gifArbiter)
+                m_gifArbiter->submit(GifPathId::Path3, packet.data() + head, static_cast<uint32_t>(length), false);
+            else if (m_gifPacketCallback)
+                m_gifPacketCallback(packet.data() + head, static_cast<uint32_t>(length));
+        }
+        m_path3MaskedHead = head + length;
+        if (m_path3MaskedHead >= packet.size())
+        {
+            m_path3MaskedFifo.erase(m_path3MaskedFifo.begin());
+            m_path3MaskedHead = 0u;
+        }
+    }
+    // The packet did not end inside the queue: its rest passes when the DMA delivers it, even if masked again.
+    m_path3PassUntilEop = !ended;
+    if (m_gifArbiter)
+        m_gifArbiter->drain();
+}
