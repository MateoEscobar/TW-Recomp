+// TWR: PATH3 packet cursor. Walks GIFtags (data is qword aligned: DMA submissions) and returns how many bytes of
+// data belong to the packet being released; ended = its EOP tag and payload are complete within data.
+size_t PS2Memory::path3PacketSpan(const uint8_t *data, size_t sizeBytes, bool &ended)
+{
+    ended = false;
+    size_t offset = 0u;
+    while (offset < sizeBytes)
+    {
+        if (m_path3EopPayload != 0u)
+        {
+            const size_t bytes = std::min<size_t>(m_path3EopPayload, sizeBytes - offset);
+            m_path3EopPayload -= static_cast<uint32_t>(bytes);
+            offset += bytes;
+            if (m_path3EopPayload == 0u && m_path3EopPending)
+            {
+                m_path3EopPending = false;
+                ended = true;
+                return offset;
+            }
+            continue;
+        }
+        if (sizeBytes - offset < 16u)
+            return sizeBytes;
+        uint64_t lo = 0u;
+        std::memcpy(&lo, data + offset, sizeof(lo));
+        offset += 16u;
+        const uint32_t loops = static_cast<uint32_t>(lo & 0x7FFFu);
+        const bool eop = ((lo >> 15u) & 1u) != 0u;
+        const uint32_t format = static_cast<uint32_t>((lo >> 58u) & 3u);
+        uint32_t nreg = static_cast<uint32_t>((lo >> 60u) & 15u);
+        if (nreg == 0u)
+            nreg = 16u;
+        m_path3EopPayload = format == 0u ? loops * nreg * 16u
+                          : format == 1u ? ((loops * nreg + 1u) / 2u) * 16u
+                                         : loops * 16u;
+        m_path3EopPending = eop;
+        if (eop && m_path3EopPayload == 0u)
+        {
+            m_path3EopPending = false;
+            ended = true;
+            return offset;
+        }
+    }
+    return offset;
+}
