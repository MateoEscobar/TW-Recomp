+            std::array<uint8_t, 3u * 16u> packet{};
+            mem.submitGifPacket(GifPathId::Path3, packet.data(), static_cast<uint32_t>(packet.size()));
+            t.Equals((mem.readIORegister(0x10003020u) >> 24) & 0x1Fu, 3u, "three parked qwords give FQC 3");
+
+            std::array<uint8_t, 40u * 16u> big{};
+            mem.submitGifPacket(GifPathId::Path3, big.data(), static_cast<uint32_t>(big.size()));
+            t.Equals((mem.readIORegister(0x10003020u) >> 24) & 0x1Fu, 16u, "FQC saturates at the 16-qword FIFO");
+
+            const uint32_t clearMask = makeVifCmd(0x06u, 0u, 0x0000u);
+            mem.processVIF1Data(reinterpret_cast<const uint8_t *>(&clearMask), sizeof(clearMask));
+            t.Equals((mem.readIORegister(0x10003020u) >> 24) & 0x1Fu, 0u, "unmasking drains the FIFO");
+        });
+
         tc.Run("VIF1 FIFO MSKPATH3 is visible through GIF_STAT", [](TestCase &t)
