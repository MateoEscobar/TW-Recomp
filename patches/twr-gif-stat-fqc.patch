+        tc.Run("GIF_STAT.FQC counts PATH3 data parked while MSKPATH3 masks it", [](TestCase &t)
+        {
+            // TWR: The Warriors kicks GIF DMA with PATH3 masked and spins until FQC is non-zero.
+            PS2Memory mem;
