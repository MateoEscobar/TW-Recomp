diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index cb2f58d..ad1d661 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -2352,6 +2352,14 @@ uint32_t PS2Memory::readIORegister(uint32_t address)
                (m_path3Masked ? 0x2u : 0u) |
                (mode & 0x4u) |
                (ctrl & 0x8u);
+        // TWR: FQC (bits 24-28) = PATH3 data parked in the GIF FIFO while MSKPATH3 masks it (16 qwords at most).
+        // The Warriors (RenderWare, 0x48B9A8) kicks GIF DMA with PATH3 masked and spins until the FIFO fills
+        // before it starts VIF1; FQC stuck at 0 hung the main thread there.
+        uint64_t parkedBytes = 0u;
+        for (const auto &packet : m_path3MaskedFifo)
+            parkedBytes += packet.size();
+        const uint32_t fqc = static_cast<uint32_t>(std::min<uint64_t>(16u, parkedBytes / 16u));
+        stat = (stat & ~0x1F000000u) | (fqc << 24u);
         return stat;
     }
 
