+            TestEnv env;
+            constexpr uint32_t kMainStackSize = 0x00010000u;
+            env.runtime.setPrivateGuestHeap(0x000A0000u, 0x000FF000u);
+            env.runtime.setAsyncCallbackStackRange(0x00080000u, 0x000A0000u);
+
+            setRegU32(env.ctx, 29, PS2_RAM_SIZE - 0x10u);
+            setRegU32(env.ctx, 4, 0x0036A7F0u);
+            setRegU32(env.ctx, 5, 0xFFFFFFFFu);
+            setRegU32(env.ctx, 6, kMainStackSize);
+            t.IsTrue(callSyscall(0x3Cu, env.rdram.data(), &env.ctx, &env.runtime), "SetupThread should dispatch");
+            const uint32_t stackBottom = ::getRegU32(&env.ctx, 2);
+
+            setRegU32(env.ctx, 4, 0x00715B60u);
+            setRegU32(env.ctx, 5, 0xFFFFFFFFu);
+            t.IsTrue(callSyscall(0x3Du, env.rdram.data(), &env.ctx, &env.runtime), "SetupHeap should dispatch");
+            t.IsTrue(callSyscall(0x3Eu, env.rdram.data(), &env.ctx, &env.runtime), "EndOfHeap should dispatch");
+            t.Equals(::getRegU32(&env.ctx, 2), stackBottom, "EndOfHeap should end where the main stack starts");
+            t.IsTrue(stackBottom > 0x01F00000u, "the game heap must not be clipped at 0x01F00000");
+
+            const uint32_t a = env.runtime.guestMalloc(0x100u, 16u);
+            t.IsTrue(a >= 0x000A0000u && a + 0x100u <= 0x000FF000u, "runtime allocations stay in the private heap");
+            const uint32_t sp = env.runtime.reserveAsyncCallbackStack(0x1000u, 16u);
+            t.IsTrue(sp > 0x00080000u && sp <= 0x000A0000u, "interrupt stacks stay in their fixed range");
+        });
