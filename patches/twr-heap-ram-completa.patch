+void PS2Runtime::setAsyncCallbackStackRange(uint32_t floor, uint32_t top)
+{
+    std::lock_guard<std::mutex> lock(m_asyncCallbackStackMutex);
+    m_asyncCallbackStackFloor = floor & ~(kGuestHeapDefaultAlignment - 1u);
+    m_asyncCallbackStackTop = std::min(top, PS2_RAM_SIZE) & ~(kGuestHeapDefaultAlignment - 1u);
+    std::cerr << "[stack] pilas de interrupciones en 0x" << std::hex << m_asyncCallbackStackFloor << "-0x"
+              << m_asyncCallbackStackTop << std::dec << std::endl;
+}
+
+void PS2Runtime::setGameHeap(uint32_t guestBase, uint32_t guestEnd)
+{
+    {
+        std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+        m_gameHeapEnd = guestEnd;
+    }
+    configureGuestHeap(guestBase, guestEnd);
+    std::lock_guard<std::mutex> lock(m_asyncCallbackStackMutex);
+    if (guestEnd > m_asyncCallbackStackFloor && guestBase < m_asyncCallbackStackTop)
+    {
+        std::cerr << "[heap] AVISO: el heap del juego (0x" << std::hex << guestBase << "-0x" << guestEnd
+                  << ") cubre las pilas de interrupciones (0x" << m_asyncCallbackStackFloor << "-0x"
+                  << m_asyncCallbackStackTop << "); muevalas con setAsyncCallbackStackRange" << std::dec << std::endl;
+    }
+}
+
+uint32_t PS2Runtime::gameHeapEnd() const
+{
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    return m_gameHeapEnd;
+}
+
+void PS2Runtime::setMainThreadStackBottom(uint32_t bottom)
+{
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    m_mainThreadStackBottom = bottom;
+}
+
+uint32_t PS2Runtime::mainThreadStackBottom() const
+{
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    return m_mainThreadStackBottom;
+}
+
 void PS2Runtime::setPrivateGuestHeap(uint32_t base, uint32_t limit)
 {
     std::lock_guard<std::mutex> lock(m_guestHeapMutex);
