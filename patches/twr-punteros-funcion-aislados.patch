         return name == ".ctors" || name == ".dtors" || name == ".init_array" || name == ".fini_array";
     }
 
+    // TWR: the instruction right after a `jr ra` and its delay slot that allocates a stack frame (addiu sp,sp,-N).
+    // A data word pointing there is a function pointer even when it stands alone: code after an early return that
+    // a switch table reaches never allocates a new frame. The Warriors keeps isolated method pointers like this in
+    // object tables in .data (0x0024E720 at 0x0050B5E4); without the split the call landed inside another function.
+    bool IsPostReturnStackPrologue(const std::vector<ps2recomp::Section> &sections, uint32_t target)
+    {
+        uint32_t returnRaw = 0;
+        uint32_t entryRaw = 0;
+        if (target < 2u * MIPS_INSTRUCTION_SIZE ||
+            !ReadWordByAddress(sections, target - 2u * MIPS_INSTRUCTION_SIZE, returnRaw) ||
+            !ReadWordByAddress(sections, target, entryRaw))
+        {
+            return false;
+        }
+        constexpr uint32_t kJrRa = 0x03E00008u;
+        const bool allocatesFrame = (entryRaw >> 16) == 0x27BDu && (entryRaw & 0x8000u) != 0u; // addiu sp,sp,-N
+        return returnRaw == kJrRa && allocatesFrame && !IsDelaySlotOfControlTransfer(sections, target);
+    }
+
